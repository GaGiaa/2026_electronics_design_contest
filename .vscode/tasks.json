{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MSPM0: Build",
      "type": "shell",
      "command": "D:\\Software\\ti\\ccs2020\\ccs\\utils\\bin\\gmake.exe",
      "args": ["-C", "${workspaceFolder}\\mspm0l1306_bringup\\Debug", "all"],
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "MSPM0G3507: Build",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\build-mspm0g3507.ps1"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "MSPM0G3507 FreeRTOS: Build",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\build-mspm0g3507-freertos.ps1"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "MSPM0G3507 App: Build",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\build-mspm0g3507-app.ps1"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "MSPM0G3507: Install pyOCD tools",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\install-g3507-debug-tools.ps1"],
      "problemMatcher": []
    },
    {
      "label": "MSPM0G3507: List pyOCD probes",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\flash-and-debug-g3507.ps1", "-Action", "List"],
      "problemMatcher": []
    },
    {
      "label": "MSPM0G3507: Load firmware to Flash",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\flash-and-debug-g3507.ps1", "-Action", "Load"],
      "problemMatcher": []
    },
    {
      "label": "MSPM0G3507 FreeRTOS: Load firmware to Flash",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\flash-and-debug-g3507.ps1", "-Action", "Load", "-Firmware", "freertos"],
      "problemMatcher": []
    },
    {
      "label": "MSPM0G3507 App: Load firmware to Flash",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\flash-and-debug-g3507.ps1", "-Action", "Load", "-Firmware", "app"],
      "problemMatcher": []
    },
    {
      "label": "MSPM0G3507: Start pyOCD GDB server",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\flash-and-debug-g3507.ps1", "-Action", "GdbServer"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "MSPM0G3507 App: Start pyOCD GDB server",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\start-mspm0g3507-app-debug.ps1"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "pyocd",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting pyOCD GDB server",
          "endsPattern": "GDB server listening on port 3333"
        }
      }
    },
    {
      "label": "MSPM0G3507 App: Prepare debug",
      "dependsOn": ["MSPM0G3507 App: Build", "MSPM0G3507 App: Start pyOCD GDB server"],
      "dependsOrder": "sequence"
    },
    {
      "label": "MSPM0G3507 App: Stop pyOCD GDB server",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\stop-mspm0g3507-app-debug.ps1"],
      "problemMatcher": []
    },
    {
      "label": "MSPM0: List pyOCD probes",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\flash-and-debug.ps1", "-Action", "List"],
      "problemMatcher": []
    },
    {
      "label": "MSPM0: Load firmware to Flash",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\flash-and-debug.ps1", "-Action", "Load"],
      "problemMatcher": []
    },
    {
      "label": "MSPM0: Start pyOCD GDB server",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\flash-and-debug.ps1", "-Action", "GdbServer"],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
